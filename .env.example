# Resend (Primary Email Delivery for Pilot Briefs & Attachments up to 10 MB)
# 1. Sign up at https://resend.com
# 2. Get API key from https://resend.com/api-keys
# 3. Add sending domain (upraiser.co.uk) or use "UPRAISER Desk <onboarding@resend.dev>" for testing
RESEND_API_KEY=
RESEND_FROM_EMAIL=UPRAISER Desk <pilot@upraiser.co.uk>
NOTIFICATION_EMAIL=info@upraiser.co.uk

# Supabase (Direct Client Upload for Brief Attachments to Bypass Vercel 4.5 MB Limit)
# 1. Create a project at https://supabase.com
# 2. Go to Storage -> Create a new bucket: "temp-briefs" (Set Public: OFF)
# 3. Add an RLS Policy allowing unauthenticated upload (anon INSERT)
# 4. Copy URL, Anon Key, and Service Role Key from Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional Fallback: Web3Forms — https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# Optional: Instant Telegram Notification Bot for new leads
# 1. Create a bot with @BotFather to get your token
# 2. Get your chat_id or group/channel id (e.g. from @userinfobot)
# 3. Add bot to the group (if using a group)
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
